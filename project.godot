; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GBJAM14"
run/main_scene="uid://ct7lproag0pxq"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

SignalManager="*uid://diwt2xo3evucj"
FlagsManager="*uid://dp5itangtij18"
DialogManager="*uid://bocvvkupmjb03"

[display]

window/size/viewport_width=160
window/size/viewport_height=144
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="GBJAM14"

[input]

coletar={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":101,"location":0,"echo":false,"script":null)
]
}

[layer_names]

